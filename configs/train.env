# Shared settings for every training and evaluation run.
# Fix these after the memory check and the clean control (docs/experiment-design.md,
# protocol steps 2-3), then do NOT change them for the corrupted conditions.

SUITE=libero_object            # LIBERO suite used for training and evaluation
DATASET_REPO=lerobot/libero
DATASET_REVISION=main          # replace with the commit SHA once downloaded
BASE_POLICY=lerobot/smolvla_base

STEPS=20000                    # placeholder: set after the clean control
BATCH_SIZE=8                   # placeholder: set after the memory check
SEEDS="1000"                   # e.g. "1000 1001 1002" for the clean control

EVAL_EPISODES=50               # per task (10 tasks -> 500 episodes)
EVAL_SEED=7
N_ACTION_STEPS=10              # execution horizon; must be identical everywhere

export MUJOCO_GL=egl           # headless rendering
